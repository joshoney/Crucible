# Crucible configuration. Copy to .env and fill in:  cp .env.example .env
# docker-compose.yml reads these and passes them to the eval-worker container.

# --- Model under test (Lemonade server on your LAN) ---
# Lemonade API base; the worker POSTs to $LEMONADE_API_URL/load to provision a model
LEMONADE_API_URL=http://10.10.0.12:8000/api/v1
# OpenAI-compatible endpoint evaluerBench sends prompts to (defaults to LEMONADE_API_URL)
# TARGET_BASE_URL=http://10.10.0.12:8000/api/v1

# After /load, check GET $LEMONADE_API_URL/health lists the model before evaluating (default: true)
# LEMONADE_VERIFY_LOADED=true

# --- Judge model used by evaluerBench to grade responses ---
# OpenAI-compatible endpoint for the evaluator model
EVALUATOR_BASE_URL=http://10.10.0.12:8000/api/v1
# API key for the evaluator endpoint (any non-empty value for a local server)
EVALUATOR_API_KEY=replace-me
# Model name served by the evaluator endpoint
EVALUATOR_MODEL=your-judge-model

# --- Tracing (optional) ---
# LangSmith API key for evaluerBench traces; leave empty to skip LangSmith upload
LANGCHAIN_API_KEY=

# --- Publishing (GitHub Git Data API) ---
# Fine-grained token with Contents: read/write on GITHUB_REPO only
GITHUB_TOKEN=github_pat_replace_me
# owner/repo that receives results under src/resources/evaluerBench/
GITHUB_REPO=joshoney/devsite
# Branch to commit to (default: main)
TARGET_BRANCH=main

# --- Worker housekeeping ---
# evaluerBench branch, tag, or commit SHA baked into the eval-worker image (default: main)
# EVALUERBENCH_REF=main
# Days to keep scratch dirs of failed/cancelled runs (successful runs are deleted after publish); 0 disables
# SCRATCH_RETENTION_DAYS=7

# --- Set in docker-compose.yml; only needed when running the Python services outside Docker ---
# TEMPORAL_URL=localhost:7233
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=eval-artifacts
# SCRATCHPAD_ROOT=/app/scratchpad
